<group name="sigma,">
    <rule id="900001" level="7">
        <if_sid>18100, 60000, 60001, 60002, 60003, 60004, 60006, 60007, 60008, 60009, 60010, 60011, 60012</if_sid>
        <field name="win.eventdata.image" type="pcre2">(?i)(?:\\+whoami\.exe)$</field>
        <description>Whoami Utility Execution</description>
        <options>no_full_log</options>
        <group>windows,process_creation,</group>
        <mitre>
            <id>T1033</id>
        </mitre>
    </rule>

    <rule id="900002" level="7">
        <if_sid>18100, 60000, 60001, 60002, 60003, 60004, 60006, 60007, 60008, 60009, 60010, 60011, 60012</if_sid>
        <field name="win.eventdata.originalFileName" type="pcre2">(?i)^whoami\.exe$</field>
        <description>Whoami Utility Execution (by original filename)</description>
        <options>no_full_log</options>
        <group>windows,process_creation,</group>
        <mitre>
            <id>T1033</id>
        </mitre>
    </rule>
</group>
