<group name="sigma,">
    <rule id="900000" level="7">
        <info type="link">https://thedfirreport.com/2025/02/24/confluence-exploit-leads-to-lockbit-ransomware/</info>
        <if_sid>18100, 60000, 60001, 60002, 60003, 60004, 60006, 60007, 60008, 60009, 60010, 60011, 60012</if_sid>
        <field name="win.eventdata.parentImage" type="pcre2">(?i)(?:\\+explorer\.exe)$</field>
        <field name="win.eventdata.image" type="pcre2">(?i)(?:\\+notepad\.exe)$</field>
        <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:password.+\.txt)$|(?:password.+\.csv)$|(?:password.+\.doc)$|(?:password.+\.xls)$</field>
        <description>Notepad Password Files Discovery</description>
        <options>no_full_log</options>
        <group>windows,process_creation,</group>
        <mitre>
            <id>T1083</id>
        </mitre>
    </rule>
</group>
