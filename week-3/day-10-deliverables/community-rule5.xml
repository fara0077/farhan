<group name="sigma,">
    <rule id="900005" level="12">
        <if_sid>18100, 60000, 60001, 60002, 60003, 60004, 60006, 60007, 60008, 60009, 60010, 60011, 60012</if_sid>
        <field name="win.eventdata.image" type="pcre2">(?i)(?:\\+schtasks\.exe)$</field>
        <field name="win.eventdata.commandLine" type="pcre2">(?i)(?=.*\ /delete\ )(?=.*/tn\ \*)(?=.*\ /f)</field>
        <description>Delete All Scheduled Tasks</description>
        <options>no_full_log</options>
        <group>windows,process_creation,</group>
        <mitre>
            <id>T1489</id>
        </mitre>
    </rule>
</group>
